{
  "name": "snapfeed",
  "version": "0.6.0",
  "description": "Internal-dogfooding feedback widget for React/Next.js. Hotkey, screenshot, voice. Slack/JIRA/Linear/Discord adapters. Self-hostable, BYOK LLM, MIT.",
  "author": {
    "name": "shimoverse",
    "email": "shimoverse@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "feedback",
    "widget",
    "react",
    "nextjs",
    "devtools",
    "dogfooding",
    "internal-feedback",
    "qa",
    "beta-testing",
    "screenshot",
    "annotation",
    "voice",
    "slack",
    "jira",
    "linear"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shimoverse/snapfeed"
  },
  "homepage": "https://github.com/shimoverse/snapfeed#readme",
  "bugs": {
    "url": "https://github.com/shimoverse/snapfeed/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "snapfeed": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js",
      "require": "./dist/routing.cjs"
    },
    "./routing-sources": {
      "types": "./dist/routing-sources/index.d.ts",
      "import": "./dist/routing-sources/index.js",
      "require": "./dist/routing-sources/index.cjs"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js",
      "require": "./dist/llm/index.cjs"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js",
      "require": "./dist/voice.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./audit-log": {
      "types": "./dist/audit-log.d.ts",
      "import": "./dist/audit-log.js",
      "require": "./dist/audit-log.cjs"
    },
    "./gdpr": {
      "types": "./dist/gdpr.d.ts",
      "import": "./dist/gdpr.js",
      "require": "./dist/gdpr.cjs"
    },
    "./network-capture": {
      "types": "./dist/network-capture.d.ts",
      "import": "./dist/network-capture.js",
      "require": "./dist/network-capture.cjs"
    },
    "./screen-recording": {
      "types": "./dist/screen-recording.d.ts",
      "import": "./dist/screen-recording.js",
      "require": "./dist/screen-recording.cjs"
    },
    "./campaigns": {
      "types": "./dist/campaigns.d.ts",
      "import": "./dist/campaigns.js",
      "require": "./dist/campaigns.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "require": "./dist/messages.cjs"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js",
      "require": "./dist/headless/index.cjs"
    },
    "./server/nextjs": {
      "types": "./dist/server/nextjs.d.ts",
      "import": "./dist/server/nextjs.js",
      "require": "./dist/server/nextjs.cjs"
    },
    "./server/express": {
      "types": "./dist/server/express.d.ts",
      "import": "./dist/server/express.js",
      "require": "./dist/server/express.cjs"
    },
    "./server/security": {
      "types": "./dist/server/security.d.ts",
      "import": "./dist/server/security.js",
      "require": "./dist/server/security.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "PRIVACY.md",
    "THREAT_MODEL.md",
    "COMPLIANCE.md",
    "COMPATIBILITY.md",
    "VERSIONING.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "docs/MANUAL.md",
    "docs/PLAYBOOK.md",
    "docs/ARCHITECTURE.md",
    "docs/SECURITY_REPORT.md",
    "docs/customization.md",
    "docs/gdpr.md",
    "docs/adapters",
    "docs/quickstart",
    "docs/screenshots",
    "legal/DPA-template.md",
    "legal/THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "prepublishOnly": "npm run build && npm run type-check && npm test"
  },
  "peerDependencies": {
    "html2canvas": "^1.4.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
