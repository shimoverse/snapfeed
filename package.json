{
  "name": "snapfeed",
  "version": "0.4.0",
  "description": "One-tap feedback widget for internal dogfooding. Hotkey, screenshot, annotation, voice. Pluggable adapters: Slack, JIRA, Linear, Asana, ClickUp, Notion, MS Teams, GitHub Issues, Discord, Google Sheets, Supabase, Telegram, webhook, file. BYOK LLM (Anthropic, OpenAI, Azure, Bedrock, Ollama). Routing config + Release Campaigns. Three deployment modes: cloud-relayed, self-hosted, air-gapped.",
  "author": "snapfeed contributors",
  "license": "MIT",
  "keywords": [
    "feedback",
    "widget",
    "react",
    "nextjs",
    "developer-tools",
    "devtools",
    "dogfooding",
    "internal-feedback",
    "qa",
    "beta-testing",
    "screenshot",
    "annotation",
    "slack",
    "jira",
    "linear",
    "github-issues",
    "discord",
    "google-sheets",
    "supabase",
    "telegram",
    "asana",
    "clickup",
    "notion",
    "microsoft-teams",
    "llm",
    "byok",
    "anthropic",
    "openai",
    "ollama",
    "bedrock",
    "voice-feedback",
    "release-campaigns",
    "audit-log",
    "snapfeed"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shimoverse/snapfeed"
  },
  "homepage": "https://github.com/shimoverse/snapfeed#readme",
  "bugs": {
    "url": "https://github.com/shimoverse/snapfeed/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "snapfeed": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.cjs"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.mjs",
      "require": "./dist/routing.cjs"
    },
    "./routing-sources": {
      "types": "./dist/routing-sources/index.d.ts",
      "import": "./dist/routing-sources/index.mjs",
      "require": "./dist/routing-sources/index.cjs"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.mjs",
      "require": "./dist/llm/index.cjs"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.mjs",
      "require": "./dist/voice.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.mjs",
      "require": "./dist/storage/index.cjs"
    },
    "./audit-log": {
      "types": "./dist/audit-log.d.ts",
      "import": "./dist/audit-log.mjs",
      "require": "./dist/audit-log.cjs"
    },
    "./network-capture": {
      "types": "./dist/network-capture.d.ts",
      "import": "./dist/network-capture.mjs",
      "require": "./dist/network-capture.cjs"
    },
    "./screen-recording": {
      "types": "./dist/screen-recording.d.ts",
      "import": "./dist/screen-recording.mjs",
      "require": "./dist/screen-recording.cjs"
    },
    "./campaigns": {
      "types": "./dist/campaigns.d.ts",
      "import": "./dist/campaigns.mjs",
      "require": "./dist/campaigns.cjs"
    },
    "./server/nextjs": {
      "types": "./dist/server/nextjs.d.ts",
      "import": "./dist/server/nextjs.mjs",
      "require": "./dist/server/nextjs.cjs"
    },
    "./server/express": {
      "types": "./dist/server/express.d.ts",
      "import": "./dist/server/express.mjs",
      "require": "./dist/server/express.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run type-check && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "html2canvas": "^1.4.1"
  }
}
