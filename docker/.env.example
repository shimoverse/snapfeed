# snapfeed self-hosted defaults
#
# Copy to .env and edit:   cp docker/.env.example docker/.env
# Anything left commented uses the worker's built-in default.
# Bring the stack up:      docker compose -f docker/docker-compose.yml up

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_PORT=8787
ALLOWED_ORIGINS=http://localhost:3000

# ── Adapters (set any to wire that destination) ─────────────────────────────
# Multiple adapters can be enabled at once — every payload is sent to all of them.
# SNAPFEED_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# SNAPFEED_SLACK_USERNAME=snapfeed
# SNAPFEED_SLACK_CHANNEL=#feedback
# SNAPFEED_GITHUB_TOKEN=ghp_...
# SNAPFEED_GITHUB_REPO=owner/repo
# SNAPFEED_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# SNAPFEED_TELEGRAM_BOT_TOKEN=...
# SNAPFEED_TELEGRAM_CHAT_ID=...
# SNAPFEED_WEBHOOK_URL=https://your.api/feedback
# SNAPFEED_FILE_PATH=/data/audit/snapfeed-feedback.jsonl

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=snapfeed
MINIO_ROOT_PASSWORD=snapfeed-dev-password-change-me

# ── Storage paths (inside the container) ────────────────────────────────────
SNAPFEED_AUDIT_LOG_PATH=/data/audit/snapfeed.jsonl
SNAPFEED_UPLOAD_DIR=/data/uploads
# Hash reporter email in the audit log (recommended when shipping logs off-host).
# SNAPFEED_HASH_REPORTER=true

# ── Rate limit ──────────────────────────────────────────────────────────────
SNAPFEED_RATE_LIMIT_MAX=60
SNAPFEED_RATE_LIMIT_WINDOW_MS=60000

# ── Ollama (uncomment + start with --profile llm) ───────────────────────────
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3
