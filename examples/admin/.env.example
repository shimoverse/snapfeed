# ──────────────────────────────────────────────────────────────────────────────
# snapfeed admin — environment
# Copy to `.env.local` for local dev. None of these are required to render the
# app; missing files just produce empty states.
# ──────────────────────────────────────────────────────────────────────────────

# Path to the JSONL file written by snapfeed's `fileAdapter`. Each line is one
# FeedbackPayload as JSON. Read-only — the admin never mutates this file.
SNAPFEED_FEEDBACK_FILE=./feedback.jsonl

# Path to the JSONL file written by `fileAuditLog` (snapfeed/audit-log).
# Used by the /audit tab. Immutable in this admin.
SNAPFEED_AUDIT_LOG_FILE=./snapfeed-audit.jsonl

# Path to the sidecar JSONL where the admin appends triage state (status,
# notes, triagedBy, …). Default sits next to the feedback file. Append-only;
# last write wins per id.
SNAPFEED_FEEDBACK_STATUS_FILE=./feedback-status.jsonl

# Optional: path to a JSON file containing a `ReleaseCampaign[]`. Powers the
# campaign filter in the inbox and the "Active campaigns" panel on the
# dashboard. Omit to hide those surfaces.
# SNAPFEED_CAMPAIGNS_FILE=./campaigns.json

# ──────────────────────────────────────────────────────────────────────────────
# DEV ONLY — bypasses the auth shim and treats every request as an admin.
# UNCOMMENT for local dev only. In production, leave this commented out and
# front the admin app with oauth2-proxy / Pomerium / Cloudflare Access / IAP;
# have the proxy forward `x-snapfeed-admin-user` (and optionally
# `x-snapfeed-admin-email`, `x-snapfeed-admin-role`).
#
# Default-disabled to prevent a copy-paste of `.env.example` → production
# leaving the admin wide open.
# ──────────────────────────────────────────────────────────────────────────────
# SNAPFEED_ADMIN_BYPASS=1
