# snapfeed example (Remix) — environment variables
# Remix loads `.env` automatically via `remix dev`. Copy this file to
# `.env` and uncomment / fill in the destinations you want autoAdapters()
# to wire up.

# ── Slack ─────────────────────────────────────────────────────────────────
# Set any of these to wire that destination automatically.
# SNAPFEED_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SNAPFEED_SLACK_USERNAME=snapfeed
# SNAPFEED_SLACK_CHANNEL=#feedback

# ── Discord ───────────────────────────────────────────────────────────────
# Set any of these to wire that destination automatically.
# SNAPFEED_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXX/YYY

# ── GitHub Issues ─────────────────────────────────────────────────────────
# Set any of these to wire that destination automatically.
# Both vars required. Repo format: owner/repo.
# SNAPFEED_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# SNAPFEED_GITHUB_REPO=your-org/your-repo

# ── Telegram ──────────────────────────────────────────────────────────────
# Set any of these to wire that destination automatically.
# Both vars required.
# SNAPFEED_TELEGRAM_BOT_TOKEN=123456:abcdef
# SNAPFEED_TELEGRAM_CHAT_ID=-1001234567890

# ── Webhook (any HTTPS endpoint) ──────────────────────────────────────────
# Set any of these to wire that destination automatically.
# SNAPFEED_WEBHOOK_URL=https://your-endpoint.example.com/feedback

# ── File (writes JSONL on the server) ─────────────────────────────────────
# Set any of these to wire that destination automatically.
# SNAPFEED_FILE_PATH=feedback.jsonl
